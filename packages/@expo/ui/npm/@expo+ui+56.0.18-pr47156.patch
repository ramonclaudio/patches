+/**
+ * Collapses a view's subtree into a single accessibility element.
+ *
+ * Use this to group decorative children under one labeled parent. It complements
+ * `accessibilityHidden`, which hides a single leaf, by treating an entire subtree
+ * as one element.
+ *
+ * @param children - How VoiceOver should treat the descendants:
+ * - `ignore` - ignore the children and present only this element (default).
+ * - `combine` - merge the children's accessibility data into this element.
+ * - `contain` - keep the children as accessible elements within this container.
+ * @see Official [SwiftUI documentation](https://developer.apple.com/documentation/swiftui/view/accessibilityelement(children:)).
+ */
+export declare const accessibilityElement: (children?: "ignore" | "combine" | "contain") => ModifierConfig;
