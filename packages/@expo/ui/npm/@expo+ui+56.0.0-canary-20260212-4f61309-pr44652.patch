+@available(iOS 17.0, tvOS 17.0, macOS 14.0, *)
+private struct StatefulScrollView<Content: View>: View {
+  @ObservedObject var state: ObservableState
+  @ObservedObject var props: ScrollViewComponentProps
+  let content: () -> Content
+
+  init(
+    state: ObservableState,
+    props: ScrollViewComponentProps,
+    @ViewBuilder content: @escaping () -> Content
+  ) {
+    self.state = state
+    self.props = props
+    self.content = content
+  }
+
+  var body: some View {
+    let activeID = Binding<String?>(
+      get: { state.value as? String },
+      set: { state.value = $0 }
+    )
+    content()
+      .scrollPosition(id: activeID, anchor: props.scrollPositionAnchor?.toUnitPoint)
+      .onChange(of: state.value as? String) { _, newValue in
+        props.onScrollPositionChangeSync?.invoke(arguments: [newValue ?? NSNull()])
+      }
+  }
+}
