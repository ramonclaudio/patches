diff --git a/.github/workflows/ios-prebuild-external-xcframeworks.yml b/.github/workflows/ios-prebuild-external-xcframeworks.yml
index 465590257f0..61676f02d2a 100644
--- a/.github/workflows/ios-prebuild-external-xcframeworks.yml
+++ b/.github/workflows/ios-prebuild-external-xcframeworks.yml
@@ -86,21 +86,26 @@ jobs:
           retention-days: 14
           include-hidden-files: true
 
+      # The `expo` workload-identity provider (projects/321830142373/.../providers/expo)
+      # only accepts OIDC tokens from `expo/expo` refs per its trust policy. Without
+      # the repo guard a fork dispatch with `publish: true` would burn the full
+      # ~120-minute build before failing at GCP auth. Fail fast at the `if:` and
+      # avoid the wasted compute plus a noisy entry in the project's audit log.
       - name: Authenticate to Google Cloud
-        if: ${{ success() && github.event.inputs.publish == 'true' }}
+        if: ${{ success() && github.event.inputs.publish == 'true' && github.repository == 'expo/expo' }}
         uses: google-github-actions/auth@7c6bc770dae815cd3e89ee6cdf493a5fab2cc093 # v3
         with:
           project_id: exponentjs
           workload_identity_provider: projects/321830142373/locations/global/workloadIdentityPools/github/providers/expo
 
       - name: Setup gcloud
-        if: ${{ success() && github.event.inputs.publish == 'true' }}
+        if: ${{ success() && github.event.inputs.publish == 'true' && github.repository == 'expo/expo' }}
         uses: google-github-actions/setup-gcloud@e427ad8a34f8676edf47cf7d7925499adf3eb74f # v2
         with:
           project_id: exponentjs
 
       - name: Upload XCFramework directory structure to GCS
-        if: ${{ success() && github.event.inputs.publish == 'true' }}
+        if: ${{ success() && github.event.inputs.publish == 'true' && github.repository == 'expo/expo' }}
         run: |
           SYNC_ROOT="$RUNNER_TEMP/precompiled-modules-upload"
           rm -rf "$SYNC_ROOT"
