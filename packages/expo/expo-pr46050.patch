diff --git a/.github/workflows/pr-labeler.yml b/.github/workflows/pr-labeler.yml
index e66dc3fded2..9a942a66b0c 100644
--- a/.github/workflows/pr-labeler.yml
+++ b/.github/workflows/pr-labeler.yml
@@ -27,6 +27,12 @@ concurrency:
 jobs:
   test-suite-fingerprint:
     runs-on: ubuntu-24.04
+    # Second clause is load-bearing: this job has `actions: write` permission to
+    # update the fingerprint database in the action cache, and `pull-requests: write`
+    # to comment with the fingerprint diff. Fork PRs would run under those permissions
+    # if we only checked `github.repository`, so we additionally require the PR head
+    # to be in the same repo (internal branch) or the event to be a direct push to
+    # main. Keeps elevated tokens out of fork-controlled code paths.
     if: ${{ github.repository == 'expo/expo' && (github.event.pull_request.head.repo.full_name == github.repository || github.event_name == 'push') }}
     # REQUIRED: limit concurrency when pushing main(default) branch to prevent conflict for this action to update its fingerprint database
     concurrency: fingerprint-${{ github.event_name != 'pull_request' && 'main' || github.run_id }}
