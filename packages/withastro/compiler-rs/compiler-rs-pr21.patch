-func hueToRgb(t1 float64, t2 float64, hue float64) uint32 {
-	hue -= math.Floor(hue)
-	hue *= 6.0
-	var f float64
-	if hue < 1 {
-		f = (t2-t1)*hue + t1
-	} else if hue < 3 {
-		f = t2
-	} else if hue < 4 {
-		f = (t2-t1)*(4-hue) + t1
-	} else {
-		f = t1
-	}
-	i := int(math.Round(f * 255))
-	if i < 0 {
-		i = 0
-	} else if i > 255 {
-		i = 255
-	}
-	return uint32(i)
-}
