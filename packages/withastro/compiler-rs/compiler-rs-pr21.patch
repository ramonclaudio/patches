-func mangleNumber(t string) (string, bool) {
-	original := t
-
-	if dot := strings.IndexByte(t, '.'); dot != -1 {
-		// Remove trailing zeros
-		for len(t) > 0 && t[len(t)-1] == '0' {
-			t = t[:len(t)-1]
-		}
-
-		// Remove the decimal point if it's unnecessary
-		if dot+1 == len(t) {
-			t = t[:dot]
-			if t == "" || t == "+" || t == "-" {
-				t += "0"
-			}
-		} else {
-			// Remove a leading zero
