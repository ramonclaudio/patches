-	case css_lexer.TOpenBrace:
-		p.parseBlock(css_lexer.TOpenBrace, css_lexer.TCloseBrace)
-
-	case css_lexer.TOpenBracket:
-		p.parseBlock(css_lexer.TOpenBracket, css_lexer.TCloseBracket)
