-}
-
-func isSpecialElement(element *Node) bool {
-	switch element.Namespace {
-	case "", "html":
-		return isSpecialElementMap[element.Data]
-	case "math":
-		switch element.Data {
-		case "mi", "mo", "mn", "ms", "mtext", "annotation-xml":
-			return true
-		}
-	case "svg":
-		switch element.Data {
-		case "foreignObject", "desc", "title":
-			return true
-		}
-	}
-	return false
-}
-
-var knownDirectiveMap = map[string]bool{
-	"client:load":    true,
-	"client:idle":    true,
-	"client:visible": true,
-	"client:only":    true,
-	"class:list":     true,
-	"set:text":       true,
-	"set:html":       true,
-}
-
-func IsKnownDirective(element *Node, attr *Attribute) bool {
-	if knownDirectiveMap[attr.Key] {
-		return true
-	}
-	if element.DataAtom == a.Script {
-		return attr.Key == "hoist"
-	}
-	if element.DataAtom == a.Style {
-		return attr.Key == "global"
-	}
-	return false
-}
