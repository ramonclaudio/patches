-			// Generate a node for the run
-			sum := calcSum{terms: make([]calcTerm, (last-first)/2+2)}
-			for i := range sum.terms {
-				term := terms[first+i*2-1]
-				if i > 0 && terms[first+i*2-2].(*calcValue).token.Kind == css_lexer.TDelimMinus {
