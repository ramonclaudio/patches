-func (s *Source) RangeOfOperatorAfter(loc Loc, op string) Range {
-	text := s.Contents[loc.Start:]
-	index := strings.Index(text, op)
-	if index >= 0 {
-		return Range{Loc: Loc{Start: loc.Start + int32(index)}, Len: int32(len(op))}
