-	snapshotName = strings.ReplaceAll(snapshotName, "#", "_")
-	snapshotName = strings.ReplaceAll(snapshotName, "'", "_")
-	snapshotName = strings.ReplaceAll(snapshotName, "\"", "_")
-	snapshotName = strings.ReplaceAll(snapshotName, "@", "_")
-	snapshotName = strings.ReplaceAll(snapshotName, "`", "_")
-	snapshotName = strings.ReplaceAll(snapshotName, "+", "_")
