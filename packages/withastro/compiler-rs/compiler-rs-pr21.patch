+
+    #[test]
+    fn decode_named_entities() {
+        assert_eq!(decode_html_entities("&lt;"), "<");
+        assert_eq!(decode_html_entities("&gt;"), ">");
+        assert_eq!(decode_html_entities("&amp;"), "&");
