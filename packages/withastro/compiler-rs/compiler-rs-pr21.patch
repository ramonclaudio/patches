-func (s *Source) LocBeforeWhitespace(loc Loc) Loc {
-	for loc.Start > 0 {
-		c, width := utf8.DecodeLastRuneInString(s.Contents[:loc.Start])
-		if c != ' ' && c != '\t' && c != '\r' && c != '\n' {
-			break
-		}
-		loc.Start -= int32(width)
