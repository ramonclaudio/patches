-		// Otherwise, append " + " to s, then serialize child and append the result to s.
-		tokens = append(tokens, css_ast.Token{
-			Kind:       css_lexer.TDelimPlus,
-			Text:       "+",
-			Whitespace: css_ast.WhitespaceBefore | css_ast.WhitespaceAfter,
