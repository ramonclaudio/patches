-	if pos < len(tokens) && tokens[pos].Kind == css_lexer.TDelimSlash {
-		if pos+1 == len(tokens) {
-			return tokens
-		}
-		result = append(result, tokens[pos], tokens[pos+1])
-		pos += 2
-
-		// Remove the whitespace around the "/" character
-		if p.options.MinifyWhitespace {
