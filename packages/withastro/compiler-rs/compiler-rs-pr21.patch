+        let allocator = Allocator::default();
+        let source_type = SourceType::astro();
+        let ret = Parser::new(&allocator, source, source_type).parse_astro();
+        assert!(ret.errors.is_empty(), "Parse errors: {:?}", ret.errors);
+        extract_styles(&ret.root)
+    }
