+#[test]
+fn test_sourcemap_multiline_frontmatter_with_typescript() {
+    // Ensure TypeScript in multi-line frontmatter is stripped by Phase 2,
+    // and sourcemap still has per-line mappings.
+    let source = r"---
+interface Props {
+title: string;
