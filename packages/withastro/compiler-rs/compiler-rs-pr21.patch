-			// Replace the run with a single node
-			terms[first-1] = &sum
-			terms = append(terms[:first], terms[last+2:]...)
-			continue
-		}
-
-		first++
-	}
-
-	// This only succeeds if everything reduces to a single term
-	if len(terms) == 1 {
-		return terms[0]
-	}
-	return nil
-}
