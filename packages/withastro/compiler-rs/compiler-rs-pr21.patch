-
-		case 4:
-			// "#1234"
-			if hex, ok := parseHex(text); ok {
-				return expandHex(hex), true
-			}
-
-		case 6:
-			// "#112233"
-			if hex, ok := parseHex(text); ok {
-				return (hex << 8) | 0xFF, true
-			}
-
-		case 8:
-			// "#11223344"
-			if hex, ok := parseHex(text); ok {
