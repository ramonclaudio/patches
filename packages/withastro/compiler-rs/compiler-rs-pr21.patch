-	for _, c := range b.sourceMap {
-		if c != ';' {
-			shouldIgnore = false
-			break
-		}
-	}
-	return Chunk{
-		Buffer:               b.sourceMap,
-		EndState:             b.prevState,
-		FinalGeneratedColumn: b.generatedColumn,
-		ShouldIgnore:         shouldIgnore,
-	}
-}
