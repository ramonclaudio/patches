-		case *css_ast.RKnownAt:
-			if len(r.Rules) == 0 {
-				continue
-			}
-
-		case *css_ast.RSelector:
-			if len(r.Rules) == 0 {
-				continue
-			}
-		}
-
-		rules[n] = rule
-		n++
-	}
-	rules = rules[:n]
-
-	// Remove duplicate rules, scanning from the back so we keep the last duplicate
-	start := n
-	entries := make(map[uint32]hashEntry)
-skipRule:
-	for i := n - 1; i >= 0; i-- {
-		rule := rules[i]
-
-		// Skip over preserved comments
-		next := i - 1
