-			(value.token.Kind == css_lexer.TDelimPlus || value.token.Kind == css_lexer.TDelimMinus) {
-			// Scan over the run
-			last := first
-			for last+3 < len(terms) {
-				if value, ok := terms[last+2].(*calcValue); ok && !value.isInvalidPlusOrMinus &&
-					(value.token.Kind == css_lexer.TDelimPlus || value.token.Kind == css_lexer.TDelimMinus) {
-					last += 2
-				} else {
-					break
-				}
-			}
