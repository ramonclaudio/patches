-func (p *parser) expectValidLayerNameIdent() (string, bool) {
-	r := p.current().Range
-	text := p.decoded()
-	if !p.expect(css_lexer.TIdent) {
-		return "", false
-	}
-	switch text {
-	case "initial", "inherit", "unset":
-		p.log.Add(logger.Warning, &p.tracker, r, fmt.Sprintf("%q cannot be used as a layer name", text))
