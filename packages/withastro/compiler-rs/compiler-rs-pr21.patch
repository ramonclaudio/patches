-func (s *Source) RangeOfOperatorBefore(loc Loc, op string) Range {
-	text := s.Contents[:loc.Start]
-	index := strings.LastIndex(text, op)
-	if index >= 0 {
-		return Range{Loc: Loc{Start: int32(index)}, Len: int32(len(op))}
-	}
